# Docker Compose / production template. Keep the real file outside Git.
# For direct local Node processes, change the DATABASE_URL host from db to
# 127.0.0.1 and use an absolute VITE_API_BASE_URL in apps/web/.env.local.
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh

POSTGRES_IMAGE=postgres:17.6-bookworm
POSTGRES_DB=idosi
POSTGRES_USER=idosi
# Use the same secret in DATABASE_URL, URL-encoded when it contains reserved characters.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://idosi:replace-with-url-encoded-password@db:5432/idosi

# Publish all four images (api, migrate, worker, web) under this prefix and the
# same full commit SHA. Never reuse a tag for different source code.
IMAGE_PREFIX=registry.example.com/idosi/khohang
IMAGE_TAG=replace-with-full-40-character-git-sha
CADDY_IMAGE=caddy:2.10.2-alpine
APP_DOMAIN=kho.example.com
WEB_ORIGIN=https://kho.example.com
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000
API_STORAGE=postgres
SESSION_TTL_HOURS=12
# The secret is consumed server-side only; the settings API exposes status, never its value.
IDOSI_INTEGRATION_ENDPOINT=https://idosi.io.vn/api/integrations/warehouse/v1/order-statistics
IDOSI_INTEGRATION_SECRET=
# The worker uses the same two server-only values for scheduled aggregate snapshots.
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_MOCK_FALLBACK=false

WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3001
WORKER_POLL_MS=30000
WORKER_CATCH_UP_DAYS=0
WORKER_STORAGE=postgres

MIGRATION_LOCK_TIMEOUT_SECONDS=300
MIGRATION_DB_LOCK_TIMEOUT_MS=10000
MIGRATION_STATEMENT_TIMEOUT_MS=300000

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443

# Supply these only to the explicit one-shot bootstrap-admin command. Do not
# persist the real bootstrap password in the deployment .env file.
# After exporting them from your secret manager, run:
# docker compose --profile bootstrap run --rm bootstrap-admin
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
