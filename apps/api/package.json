{
  "name": "@idosi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bootstrap-admin": "tsx src/bootstrap-admin.ts",
    "bootstrap-admin:production": "node --enable-source-maps dist/bootstrap-admin.js",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@idosi/contracts": "0.1.0",
    "@idosi/database": "0.1.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
