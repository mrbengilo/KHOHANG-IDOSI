{
  "name": "@idosi/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent warehouse domain model and allocation policy",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "fast-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
